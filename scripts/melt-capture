#!/usr/bin/env python3
"""Host capture helper. Stdlib only so it runs without installing melt."""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

if os.name == "nt":
    import msvcrt
else:
    import fcntl

# Server-only settings such as MELT_DB_PATH stay out, so sharing compose's .env
# with the helper cannot repoint the API's database.
HELPER_ENV_KEYS = frozenset(
    {
        "MELT_TOKEN",
        "MELT_API_URL",
        "MELT_ALLOW_SECRETS",
        "MELT_STATE_DIR",
        "MELT_LOCALE_DIR",
        "MELT_CLIPBOARD_CMD",
        "MELT_NOTIFY_CMD",
    }
)
MAX_BYTES = int(os.environ.get("MELT_MAX_BYTES", "1048576"))
# urllib's default agent string is blocked by CDN bot filters in front of the API.
USER_AGENT = "melt-capture/0.1"
URL_RE = re.compile(r"^https?://\S+$")
# WinRT clipboard history: newest-first text items as {"enabled": bool, "items": [str]}.
WINDOWS_HISTORY_PS = r"""
[Console]::OutputEncoding = [Text.UTF8Encoding]::new()
$ErrorActionPreference = "Stop"
Add-Type -AssemblyName System.Runtime.WindowsRuntime | Out-Null
$null = [Windows.ApplicationModel.DataTransfer.Clipboard, Windows.ApplicationModel.DataTransfer, ContentType = WindowsRuntime]
$null = [Windows.ApplicationModel.DataTransfer.StandardDataFormats, Windows.ApplicationModel.DataTransfer, ContentType = WindowsRuntime]
$null = [Windows.ApplicationModel.DataTransfer.ClipboardHistoryItemsResult, Windows.ApplicationModel.DataTransfer, ContentType = WindowsRuntime]
$asTaskGeneric = $null
foreach ($method in [System.WindowsRuntimeSystemExtensions].GetMethods()) {
    if ($method.Name -ne "AsTask") { continue }
    $params = $method.GetParameters()
    if ($params.Count -ne 1) { continue }
    if ($params[0].ParameterType.Name -like "IAsyncOperation*") {
        $asTaskGeneric = $method
        break
    }
}
if ($null -eq $asTaskGeneric) { throw "AsTask IAsyncOperation not found" }
function Await($WinRtTask, $ResultType) {
    $asTask = $asTaskGeneric.MakeGenericMethod($ResultType)
    $netTask = $asTask.Invoke($null, @($WinRtTask))
    $netTask.Wait(-1) | Out-Null
    $netTask.Result
}
$enabled = [Windows.ApplicationModel.DataTransfer.Clipboard]::IsHistoryEnabled()
$items = New-Object System.Collections.Generic.List[string]
if ($enabled) {
    $result = Await ([Windows.ApplicationModel.DataTransfer.Clipboard]::GetHistoryItemsAsync()) ([Windows.ApplicationModel.DataTransfer.ClipboardHistoryItemsResult])
    $textFormat = [Windows.ApplicationModel.DataTransfer.StandardDataFormats]::Text
    foreach ($item in $result.Items) {
        if (-not $item.Content.Contains($textFormat)) { continue }
        try { $text = Await ($item.Content.GetTextAsync()) ([string]) } catch { continue }
        if ($null -ne $text) { $items.Add($text) }
    }
}
@{ enabled = [bool]$enabled; items = [string[]]@($items) } | ConvertTo-Json -Compress -Depth 5
"""
SECRET_RES = (
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bghp_[A-Za-z0-9]{36,}\b"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"),
    re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
)

def state_dir() -> Path:
    override = os.environ.get("MELT_STATE_DIR")
    if override:
        return Path(override)
    if os.name == "nt":
        return Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData/Local")) / "melt"
    xdg = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg) if xdg else Path.home() / ".local/state"
    return base / "melt"


def failed_file() -> Path:
    return state_dir() / "failed.jsonl"


def dead_file() -> Path:
    return state_dir() / "failed.dead.jsonl"


def lock_file() -> Path:
    return state_dir() / "helper.lock"


def sent_file() -> Path:
    return state_dir() / "sent-hashes.json"


def body_hash(body: str) -> str:
    return hashlib.sha256(body.encode("utf-8")).hexdigest()


def load_sent_hashes() -> set[str]:
    path = sent_file()
    if not path.is_file():
        return set()
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return set()
    if not isinstance(payload, list):
        return set()
    return {item for item in payload if isinstance(item, str)}


def write_sent_hashes(hashes: set[str]) -> None:
    ensure_state()
    path = sent_file()
    tmp = path.with_suffix(".tmp")
    ordered = sorted(hashes)[-5000:]
    tmp.write_text(json.dumps(ordered), encoding="utf-8")
    if os.name != "nt":
        tmp.chmod(0o600)
    tmp.replace(path)
    if os.name != "nt":
        path.chmod(0o600)


def unique_keep_last(bodies: list[str]) -> list[str]:
    seen: set[str] = set()
    kept: list[str] = []
    for body in reversed(bodies):
        if body in seen:
            continue
        seen.add(body)
        kept.append(body)
    kept.reverse()
    return kept


def select_bodies_to_post(payloads: list[str], sent: set[str], queued: set[str]) -> list[str]:
    """Send unseen history, then the current clipboard even if it was sent before."""
    payloads = unique_keep_last([body for body in payloads if body.strip()])
    if not payloads:
        return []
    *older, current = payloads
    chosen: list[str] = []
    for body in older:
        if body in queued or body_hash(body) in sent:
            continue
        chosen.append(body)
    if current not in queued:
        chosen.append(current)
    return unique_keep_last(chosen)


def load_environment() -> Path | None:
    """Fill missing helper settings from MELT_ENV_FILE, cwd, or next to a build."""
    override = os.environ.get("MELT_ENV_FILE")
    frozen = getattr(sys, "frozen", False)
    candidates = [Path(override)] if override else [Path.cwd() / ".env"]
    if frozen:
        executable_dir = Path(sys.executable).resolve().parent
        candidates.extend((executable_dir / ".env", executable_dir.parent / ".env"))
    seen: set[Path] = set()
    for path in candidates:
        path = path.resolve()
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        for raw_line in path.read_text(encoding="utf-8-sig").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            if key not in HELPER_ENV_KEYS or key in os.environ:
                continue
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
                value = value[1:-1]
            os.environ[key] = value
        return path
    return None


def locale_dir() -> Path | None:
    env = os.environ.get("MELT_LOCALE_DIR")
    if env:
        path = Path(env)
        return path if path.is_dir() else None
    roots = [Path(__file__).resolve()]
    bundle_dir = getattr(sys, "_MEIPASS", None)
    if bundle_dir:
        roots.insert(0, Path(bundle_dir))
    if getattr(sys, "frozen", False):
        roots.insert(0, Path(sys.executable).resolve().parent)
    for root in roots:
        candidate = root / "locales"
        if (candidate / "en.json").is_file():
            return candidate
    for parent in Path(__file__).resolve().parents:
        candidate = parent / "locales"
        if (candidate / "en.json").is_file():
            return candidate
    return None


def load_catalog() -> dict:
    directory = locale_dir()
    if directory is None:
        return {}
    path = directory / "en.json"
    if not path.is_file():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))


def t(catalog: dict, key: str, **kwargs: object) -> str:
    value = catalog.get(key, key)
    if kwargs:
        try:
            return str(value).format(**kwargs)
        except (KeyError, IndexError):
            return str(value)
    return str(value)


def looks_like_secret(text: str) -> bool:
    return any(pattern.search(text) for pattern in SECRET_RES)


def infer_kind(body: str) -> str:
    return "url" if URL_RE.match(body.strip()) else "text"


def notify(catalog: dict, title: str, body: str, no_notify: bool) -> None:
    if no_notify:
        print(f"{title}: {body}")
        return
    override = os.environ.get("MELT_NOTIFY_CMD")
    if os.name == "nt" and not override:
        script = (
            "Add-Type -AssemblyName System.Windows.Forms;"
            "$n=New-Object System.Windows.Forms.NotifyIcon;"
            "$n.Icon=[System.Drawing.SystemIcons]::Information;"
            "$n.BalloonTipTitle=$env:MELT_TOAST_TITLE;"
            "$n.BalloonTipText=$env:MELT_TOAST_BODY;"
            "$n.Visible=$true;$n.ShowBalloonTip(3000);"
            "Start-Sleep -Milliseconds 3500;$n.Dispose()"
        )
        env = os.environ.copy()
        env["MELT_TOAST_TITLE"] = title
        env["MELT_TOAST_BODY"] = body
        try:
            subprocess.Popen(
                ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script],
                env=env,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
        except OSError:
            print(f"{title}: {body}", file=sys.stderr)
        return
    cmd = override or "notify-send"
    try:
        subprocess.run([cmd, title, body], check=False, timeout=5)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        print(f"{title}: {body}", file=sys.stderr)


def read_clipboard() -> str | None:
    override = os.environ.get("MELT_CLIPBOARD_CMD")
    if override:
        argv = override.split()
    elif os.name == "nt":
        argv = [
            "powershell.exe",
            "-NoProfile",
            "-NonInteractive",
            "-Command",
            "[Console]::OutputEncoding=[Text.UTF8Encoding]::new(); Get-Clipboard -Raw",
        ]
    elif os.environ.get("WAYLAND_DISPLAY"):
        argv = ["wl-paste", "--type", "text/plain"]
    else:
        argv = ["xclip", "-selection", "clipboard", "-t", "text/plain", "-o"]
    try:
        result = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            timeout=5,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None
    if result.returncode != 0:
        return None
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


def parse_windows_history_json(raw: str) -> tuple[bool | None, list[str]]:
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None, []
    if not isinstance(payload, dict):
        return None, []
    enabled = payload.get("enabled")
    items = payload.get("items")
    if items is None:
        items = []
    if isinstance(items, str):
        items = [items]
    if not isinstance(items, list):
        return None, []
    texts = [item for item in items if isinstance(item, str)]
    if not isinstance(enabled, bool):
        enabled = None
    return enabled, texts


def read_windows_history() -> tuple[bool | None, list[str]]:
    encoded = base64.b64encode(WINDOWS_HISTORY_PS.encode("utf-16-le")).decode("ascii")
    try:
        result = subprocess.run(
            ["powershell.exe", "-NoProfile", "-NonInteractive", "-EncodedCommand", encoded],
            check=False,
            capture_output=True,
            timeout=20,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return None, []
    if result.returncode != 0:
        return None, []
    try:
        raw = result.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None, []
    return parse_windows_history_json(raw.strip())


def read_clipboard_payloads() -> list[str]:
    """Windows: older history first, then the current clipboard. Else: current only."""
    if os.environ.get("MELT_CLIPBOARD_CMD"):
        text = read_clipboard()
        return [text] if text is not None else []
    current = read_clipboard()
    if os.name != "nt":
        return [current] if current is not None else []
    _enabled, newest_first = read_windows_history()
    older = list(reversed(newest_first[1:])) if len(newest_first) > 1 else []
    if current is None and newest_first:
        current = newest_first[0]
    payloads: list[str] = list(older)
    if current is not None:
        payloads.append(current)
    return payloads


def ensure_state() -> None:
    path = state_dir()
    path.mkdir(parents=True, exist_ok=True)
    if os.name != "nt":
        path.chmod(0o700)


def acquire_lock() -> int | None:
    ensure_state()
    fd = os.open(lock_file(), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        if os.name == "nt":
            if os.fstat(fd).st_size == 0:
                os.write(fd, b"\0")
            os.lseek(fd, 0, os.SEEK_SET)
            msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
        else:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        os.close(fd)
        return None
    return fd


def release_lock(fd: int) -> None:
    if os.name == "nt":
        os.lseek(fd, 0, os.SEEK_SET)
        msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
    else:
        fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)


def append_jsonl(path: Path, obj: dict) -> None:
    ensure_state()
    line = json.dumps(obj, ensure_ascii=False) + "\n"
    fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
    try:
        if os.name != "nt":
            os.fchmod(fd, 0o600)
        os.write(fd, line.encode("utf-8"))
    finally:
        os.close(fd)


def load_failed() -> list[dict]:
    path = failed_file()
    if not path.is_file():
        return []
    rows: list[dict] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            append_jsonl(dead_file(), {"ts": time.time(), "kind": "torn", "body": line, "error": "torn"})
    return rows


def write_failed(rows: list[dict]) -> None:
    ensure_state()
    path = failed_file()
    tmp = path.with_suffix(".tmp")
    payload = "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in rows)
    tmp.write_text(payload, encoding="utf-8")
    if os.name != "nt":
        tmp.chmod(0o600)
    tmp.replace(path)
    if os.name != "nt":
        path.chmod(0o600)


def collapse_failed(rows: list[dict]) -> list[dict]:
    seen: dict[str, dict] = {}
    order: list[str] = []
    for row in rows:
        key = row.get("idempotency_key") or str(uuid.uuid4())
        if key not in seen:
            order.append(key)
        seen[key] = row
    return [seen[key] for key in order]


def post_capture(api: str, token: str, kind: str, body: str, key: str) -> tuple[int, dict]:
    req = urllib.request.Request(
        api.rstrip("/") + "/v1/captures",
        data=json.dumps({"kind": kind, "body": body}).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Idempotency-Key": key,
            "Content-Type": "application/json",
            "User-Agent": USER_AGENT,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            payload = json.loads(resp.read().decode("utf-8") or "{}")
            return resp.status, payload
    except urllib.error.HTTPError as exc:
        try:
            payload = json.loads(exc.read().decode("utf-8") or "{}")
        except json.JSONDecodeError:
            payload = {}
        return exc.code, payload
    except urllib.error.URLError as exc:
        return 0, {"error": str(exc.reason)}


def classify_status(status: int) -> str:
    if status in {401, 403}:
        return "auth"
    if status in {400, 409}:
        return "generic"
    if status == 413:
        return "too_large"
    if status == 0 or status >= 500:
        return "api_unreachable"
    return "generic"


def toast_for(catalog: dict, code: str, no_notify: bool) -> None:
    title = t(catalog, f"error.{code}.title")
    body = t(catalog, f"error.{code}.body")
    if title == f"error.{code}.title":
        title = t(catalog, "toast.failed")
        body = code
    notify(catalog, title, body, no_notify)


def replay_queue(catalog: dict, api: str, token: str, no_notify: bool) -> bool:
    """Replay failed.jsonl. Return False if live capture must be skipped."""
    rows = collapse_failed(load_failed())
    remaining: list[dict] = []
    skip_live = False
    i = 0
    while i < len(rows):
        row = rows[i]
        status, payload = post_capture(
            api, token, row.get("kind") or "text", row.get("body") or "", row["idempotency_key"]
        )
        if 200 <= status < 300:
            occ = int(payload.get("occurrence_count") or 1)
            msg = t(catalog, "toast.saved_nth", n=occ) if occ > 1 else t(catalog, "toast.saved")
            notify(catalog, msg, "", no_notify)
            i += 1
            continue
        if status in {400, 413}:
            append_jsonl(dead_file(), {**row, "error": status})
            i += 1
            continue
        remaining = rows[i:]
        skip_live = True
        break
    else:
        remaining = []
    write_failed(remaining)
    return not skip_live


def doctor(catalog: dict) -> int:
    print(f"env file: {load_environment()}")
    print(f"locale: {locale_dir()}")
    print(f"api: {os.environ.get('MELT_API_URL', 'http://127.0.0.1:8080')}")
    print(f"token set: {'yes' if os.environ.get('MELT_TOKEN') else 'no'}")
    print(f"failed.jsonl: {failed_file()}")
    binaries = ("powershell.exe",) if os.name == "nt" else ("notify-send", "wl-paste", "xclip")
    for binary in binaries:
        print(f"{binary}: {shutil.which(binary) or 'missing'}")
    if os.name == "nt":
        enabled, items = read_windows_history()
        if enabled is True:
            state = "on"
        elif enabled is False:
            state = "off"
        else:
            state = "unread"
        print(f"clipboard history: {state} ({len(items)} text)")
    api = os.environ.get("MELT_API_URL", "http://127.0.0.1:8080")
    try:
        health = urllib.request.Request(
            api.rstrip("/") + "/healthz",
            headers={"User-Agent": USER_AGENT},
        )
        with urllib.request.urlopen(health, timeout=3) as resp:
            print(f"healthz: {resp.status}")
    except Exception as exc:  # noqa: BLE001: doctor must print any failure
        print(f"healthz: {exc}")
        return 1
    if not catalog:
        print("locale catalog: missing")
        return 1
    print("locale catalog: ok")
    return 0


def capture_bodies(args: argparse.Namespace, catalog: dict, no_notify: bool) -> list[str] | None:
    if args.stdin:
        data = sys.stdin.read()
        try:
            data.encode("utf-8")
        except UnicodeEncodeError:
            toast_for(catalog, "clipboard_empty", no_notify)
            return None
        if not data.strip():
            toast_for(catalog, "clipboard_empty", no_notify)
            return None
        return [data]
    payloads = read_clipboard_payloads()
    queued = {row.get("body") for row in load_failed() if isinstance(row.get("body"), str)}
    bodies = select_bodies_to_post(payloads, load_sent_hashes(), queued)
    if not bodies:
        if any(body.strip() for body in payloads):
            return []
        toast_for(catalog, "clipboard_empty", no_notify)
        return None
    return bodies


def queue_capture(status: int, kind: str, body: str, key: str) -> None:
    if status in {400, 413}:
        append_jsonl(
            dead_file(),
            {
                "ts": time.time(),
                "kind": kind,
                "body": body if status != 413 else "",
                "idempotency_key": key,
                "error": status,
            },
        )
        return
    append_jsonl(
        failed_file(),
        {
            "ts": time.time(),
            "kind": kind,
            "body": body,
            "idempotency_key": key,
            "error": status,
        },
    )


def toast_saved(catalog: dict, saved: int, last_occ: int, no_notify: bool) -> None:
    if saved > 1:
        notify(catalog, t(catalog, "toast.saved_batch", n=saved), "", no_notify)
        return
    msg = t(catalog, "toast.saved_nth", n=last_occ) if last_occ > 1 else t(catalog, "toast.saved")
    notify(catalog, msg, "", no_notify)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="melt-capture",
        description="Save clipboard text to a local melt inbox.",
        epilog=(
            "Examples:\n"
            "  melt-capture\n"
            "  melt-capture --stdin --no-notify < note.txt\n"
            "  melt-capture --doctor"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--stdin", action="store_true", help="read payload from stdin")
    parser.add_argument("--doctor", action="store_true")
    parser.add_argument("--no-notify", action="store_true")
    parser.add_argument("--allow-secrets", action="store_true")
    args = parser.parse_args(argv)
    load_environment()
    catalog = load_catalog()
    if args.doctor:
        return doctor(catalog)
    if not catalog:
        notify({}, "locale_missing", "locale_missing", args.no_notify)
        return 1

    fd = acquire_lock()
    if fd is None:
        toast_for(catalog, "generic", args.no_notify)
        return 1
    try:
        api = os.environ.get("MELT_API_URL", "http://127.0.0.1:8080")
        token = os.environ.get("MELT_TOKEN", "")
        allow = args.allow_secrets or os.environ.get("MELT_ALLOW_SECRETS") == "1"
        if not replay_queue(catalog, api, token, args.no_notify):
            toast_for(catalog, "auth" if not token else "api_unreachable", args.no_notify)
            return 1
        bodies = capture_bodies(args, catalog, args.no_notify)
        if bodies is None:
            return 1
        if not bodies:
            return 0
        sent = load_sent_hashes()
        saved = 0
        last_occ = 1
        skipped_secret = 0
        skipped_large = 0
        for index, body in enumerate(bodies):
            if len(body.encode("utf-8")) > MAX_BYTES:
                append_jsonl(
                    dead_file(),
                    {
                        "ts": time.time(),
                        "kind": infer_kind(body),
                        "body": "",
                        "idempotency_key": str(uuid.uuid4()),
                        "error": "too_large",
                    },
                )
                skipped_large += 1
                continue
            if not allow and looks_like_secret(body):
                skipped_secret += 1
                continue
            kind = infer_kind(body)
            key = str(uuid.uuid4())
            status, payload = post_capture(api, token, kind, body, key)
            if 200 <= status < 300:
                saved += 1
                last_occ = int(payload.get("occurrence_count") or 1)
                sent.add(body_hash(body))
                write_sent_hashes(sent)
                continue
            if status in {400, 413}:
                queue_capture(status, kind, body, key)
                continue
            queue_capture(status, kind, body, key)
            for rest in bodies[index + 1 :]:
                queue_capture(status, infer_kind(rest), rest, str(uuid.uuid4()))
            if saved:
                toast_saved(catalog, saved, last_occ, args.no_notify)
            toast_for(catalog, classify_status(status), args.no_notify)
            return 1
        if saved:
            toast_saved(catalog, saved, last_occ, args.no_notify)
            return 0
        if skipped_secret:
            toast_for(catalog, "secret_blocked", args.no_notify)
            return 1
        if skipped_large:
            toast_for(catalog, "too_large", args.no_notify)
            return 1
        toast_for(catalog, "clipboard_empty", args.no_notify)
        return 1
    finally:
        release_lock(fd)


if __name__ == "__main__":
    raise SystemExit(main())
